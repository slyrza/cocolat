{
    "name": "ghtun",
    "build": {
        "dockerfile": "./Dockerfile",
        "context": "."
    },
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": false
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest"
        }
    },
    "postAttachCommand": {
        "start": "python3 /app/bot.py"
    },
    "forwardPorts": [443],
    "portsAttributes": {
        "443": {
            "label": "xray",
            "protocol": "http",
            "onAutoForward": "silent"
        }
    },
    "hostRequirements": {
        "cpus": 2
    }
}
